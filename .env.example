# Paprika account credentials (required)
PAPRIKA_EMAIL=you@example.com
PAPRIKA_PASSWORD=your-password

# --- MCP server transport (optional) ---
# Unset → stdio (local, Claude Desktop). Allowed values: stdio | http
# MCP_TRANSPORT=http

# HTTP mode only (ignored in stdio mode)
# MCP_HOST=127.0.0.1    # default (fail-closed); set to this machine's LAN IP to serve the network
#                       # must be an IP literal: hostnames (even localhost) and bind-all (0.0.0.0, ::) are rejected
# MCP_PORT=8000         # default; must be 1-65535

# Do NOT set FASTMCP_* variables here. FastMCP reads this same .env file
# with prefix FASTMCP_, and those keys become live framework config that
# bypasses this project's resolver.

# --- Per-device bearer tokens (HTTP mode only; ignored in stdio mode) ---
# MCP_API_KEY_<DEVICE>=<token>, one line per client device; at least one is
# required when MCP_TRANSPORT=http. The suffix names the device and becomes
# the authenticated client id. Tokens must be non-empty, ASCII, and unique
# across devices. No minimum length is enforced, so generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send "Authorization: Bearer <token>". To revoke a device, delete its
# line and restart the server.
# MCP_API_KEY_LAPTOP=<token>
# MCP_API_KEY_DESKTOP=<token>
